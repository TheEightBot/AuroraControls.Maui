<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════
         AURORA CONTROLS DESIGN SYSTEM - STYLES
         Premium Modern Mobile Design (2025)
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════════════════
         SPACING SYSTEM
         ═══════════════════════════════════════════════════════════════════════ -->
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">16</x:Double>
    <x:Double x:Key="SpacingL">24</x:Double>
    <x:Double x:Key="SpacingXL">32</x:Double>
    <x:Double x:Key="SpacingXXL">48</x:Double>

    <Thickness x:Key="PagePadding">16</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="SectionPadding">16,24</Thickness>

    <!-- ═══════════════════════════════════════════════════════════════════════
         COMPONENT TOKENS
         ═══════════════════════════════════════════════════════════════════════ -->
    <x:Double x:Key="CardCornerRadius">16</x:Double>
    <x:Double x:Key="ButtonCornerRadius">12</x:Double>
    <x:Double x:Key="InputCornerRadius">8</x:Double>
    <x:Double x:Key="BottomSheetCornerRadius">24</x:Double>
    <x:Double x:Key="ChipCornerRadius">20</x:Double>

    <x:Double x:Key="CardElevation">8</x:Double>
    <x:Double x:Key="NavigationBarHeight">80</x:Double>

    <!-- ═══════════════════════════════════════════════════════════════════════
         TYPOGRAPHY - Font Sizes
         ═══════════════════════════════════════════════════════════════════════ -->
    <x:Double x:Key="FontSizeDisplayLarge">32</x:Double>
    <x:Double x:Key="FontSizeDisplayMedium">28</x:Double>
    <x:Double x:Key="FontSizeDisplaySmall">24</x:Double>
    <x:Double x:Key="FontSizeHeadlineLarge">28</x:Double>
    <x:Double x:Key="FontSizeHeadlineMedium">24</x:Double>
    <x:Double x:Key="FontSizeHeadlineSmall">20</x:Double>
    <x:Double x:Key="FontSizeTitleLarge">20</x:Double>
    <x:Double x:Key="FontSizeTitleMedium">16</x:Double>
    <x:Double x:Key="FontSizeTitleSmall">14</x:Double>
    <x:Double x:Key="FontSizeBodyLarge">16</x:Double>
    <x:Double x:Key="FontSizeBodyMedium">14</x:Double>
    <x:Double x:Key="FontSizeBodySmall">12</x:Double>
    <x:Double x:Key="FontSizeLabelLarge">14</x:Double>
    <x:Double x:Key="FontSizeLabelMedium">12</x:Double>
    <x:Double x:Key="FontSizeLabelSmall">11</x:Double>
    
    <!-- Legacy Font Sizes (for backwards compatibility) -->
    <x:Double x:Key="FontSizeDisplay">28</x:Double>
    <x:Double x:Key="FontSizeHeadline">24</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeSubtitle">18</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeLabel">12</x:Double>
    <x:Double x:Key="FontSizeCaption">11</x:Double>

    <!-- ═══════════════════════════════════════════════════════════════════════
         M3 TYPOGRAPHY STYLES - Display
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="DisplayLarge" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplayLarge}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>
    
    <Style x:Key="DisplayMedium" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplayMedium}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>
    
    <Style x:Key="DisplaySmall" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplaySmall}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         M3 TYPOGRAPHY STYLES - Headline
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="HeadlineLarge" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeadlineLarge}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>
    
    <Style x:Key="HeadlineMedium" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeadlineMedium}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>
    
    <Style x:Key="HeadlineSmall" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeadlineSmall}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         M3 TYPOGRAPHY STYLES - Title
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="TitleLarge" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitleLarge}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>
    
    <Style x:Key="TitleMedium" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitleMedium}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>
    
    <Style x:Key="TitleSmall" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitleSmall}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         M3 TYPOGRAPHY STYLES - Body
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="BodyLarge" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>
    
    <Style x:Key="BodyMedium" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyMedium}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>
    
    <Style x:Key="BodySmall" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodySmall}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         M3 TYPOGRAPHY STYLES - Label
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="LabelLarge" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabelLarge}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>
    
    <Style x:Key="LabelMedium" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabelMedium}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>
    
    <Style x:Key="LabelSmall" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabelSmall}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         LEGACY LABEL STYLES (for backwards compatibility)
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="DisplayLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="HeadlineLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeadline}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="SubtitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="BodyLargeLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

    <Style x:Key="LabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightOnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         CARD STYLES
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="CardFrame" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}" />
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#20000000" Offset="0,4" Radius="8" Opacity="0.15" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ElevatedCardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurfaceContainer}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#30000000" Offset="0,6" Radius="12" Opacity="0.2" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         BUTTON STYLES
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource AuroraPurple}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource AuroraPurple}" />
        <Setter Property="BorderColor" Value="{StaticResource AuroraPurple}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="TertiaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurfaceVariant}, Dark={StaticResource DarkSurfaceVariant}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightOnSurface}, Dark={StaticResource DarkOnSurface}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         PAGE STYLES
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="BasePage" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" />
    </Style>

    <Style x:Key="DemoPageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         CARD STYLE (Border-based)
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#20000000" Offset="0,4" Radius="8" Opacity="0.15" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         OUTLINE BUTTON STYLE
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="OutlineButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource AuroraPurple}" />
        <Setter Property="BorderColor" Value="{StaticResource AuroraPurple}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         COLLECTION VIEW STYLES
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="CategoryListStyle" TargetType="CollectionView">
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SEPARATOR STYLES
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="SeparatorLine" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         THEME-AWARE LABEL STYLES
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="PageTitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Light.TextPrimary}, Dark={StaticResource Dark.TextPrimary}}" />
    </Style>

    <Style x:Key="SectionTitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Light.TextPrimary}, Dark={StaticResource Dark.TextPrimary}}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="BodyTextLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Light.TextSecondary}, Dark={StaticResource Dark.TextSecondary}}" />
    </Style>

    <Style x:Key="DescriptionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Light.TextSecondary}, Dark={StaticResource Dark.TextSecondary}}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="MutedTextLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Light.TextTertiary}, Dark={StaticResource Dark.TextTertiary}}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         THEME-AWARE CONTAINER STYLES
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ThemedPage" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Light.PageBackground}, Dark={StaticResource Dark.PageBackground}}" />
    </Style>

    <Style x:Key="ThemedCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Light.Surface}, Dark={StaticResource Dark.Surface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Light.Border}, Dark={StaticResource Dark.Border}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedCardElevated" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Light.Surface}, Dark={StaticResource Dark.Surface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Light.Border}, Dark={StaticResource Dark.Border}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light=#30000000, Dark=#20000000}" Offset="0,4" Radius="8" Opacity="0.15" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedHeader" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Light.Surface}, Dark={StaticResource Dark.Surface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Light.Border}, Dark={StaticResource Dark.Border}}" />
        <Setter Property="StrokeThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <Style x:Key="ThemedNestedCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Light.SurfaceContainer}, Dark={StaticResource Dark.SurfaceVariant}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         THEME-AWARE INPUT STYLES
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ThemedEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Light.TextPrimary}, Dark={StaticResource Dark.TextPrimary}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Light.TextTertiary}, Dark={StaticResource Dark.TextTertiary}}" />
    </Style>

    <Style x:Key="ThemedSearchBox" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Light.Surface}, Dark={StaticResource Dark.Surface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Light.Border}, Dark={StaticResource Dark.Border}}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         THEME-AWARE BUTTON STYLES
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ThemedSecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Light.ButtonSecondary}, Dark={StaticResource Dark.ButtonSecondary}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Light.ButtonSecondaryText}, Dark={StaticResource Dark.ButtonSecondaryText}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style x:Key="ThemedIconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Light.SurfaceVariant}, Dark={StaticResource Dark.SurfaceVariant}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Light.TextPrimary}, Dark={StaticResource Dark.TextPrimary}}" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
    </Style>

</ResourceDictionary>
