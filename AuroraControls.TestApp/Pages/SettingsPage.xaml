<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AuroraControls.TestApp.Pages.SettingsPage"
             Title="Settings"
             Style="{StaticResource DemoPageStyle}"
             BackgroundColor="{StaticResource SurfaceDim}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Appearance Section -->
            <Label Text="Appearance"
                   Style="{StaticResource TitleMedium}"
                   TextColor="{StaticResource AuroraPurple}"
                   Margin="0,0,0,8" />

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="0">

                    <!-- Theme Toggle -->
                    <Grid Padding="12"
                          ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="🌙" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Dark Mode" Style="{StaticResource TitleSmall}" />
                            <Label Text="Use dark color scheme" Style="{StaticResource BodySmall}" Opacity="0.6" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2"
                                x:Name="DarkModeSwitch"
                                IsToggled="True"
                                Toggled="OnDarkModeToggled"
                                VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource SurfaceContainer}" />

                    <!-- Accent Color -->
                    <Grid Padding="12"
                          ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="🎨" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Accent Color" Style="{StaticResource TitleSmall}" />
                            <Label Text="Aurora Purple" Style="{StaticResource BodySmall}" Opacity="0.6" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2"
                                BackgroundColor="{StaticResource AuroraPurple}"
                                StrokeShape="RoundRectangle 4"
                                Stroke="Transparent"
                                HeightRequest="24"
                                WidthRequest="24"
                                VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Developer Section -->
            <Label Text="Developer"
                   Style="{StaticResource TitleMedium}"
                   TextColor="{StaticResource AuroraPurple}"
                   Margin="0,16,0,8" />

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="0">

                    <!-- Show Performance Overlay -->
                    <Grid Padding="12"
                          ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="📊" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Performance Overlay" Style="{StaticResource TitleSmall}" />
                            <Label Text="Show FPS and render time" Style="{StaticResource BodySmall}" Opacity="0.6" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2"
                                x:Name="PerformanceSwitch"
                                IsToggled="False"
                                VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource SurfaceContainer}" />

                    <!-- Debug Borders -->
                    <Grid Padding="12"
                          ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="🔲" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Debug Borders" Style="{StaticResource TitleSmall}" />
                            <Label Text="Show control boundaries" Style="{StaticResource BodySmall}" Opacity="0.6" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2"
                                x:Name="DebugBordersSwitch"
                                IsToggled="False"
                                VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- About Section -->
            <Label Text="About"
                   Style="{StaticResource TitleMedium}"
                   TextColor="{StaticResource AuroraPurple}"
                   Margin="0,16,0,8" />

            <Border Style="{StaticResource CardStyle}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🌌 Aurora Controls"
                           Style="{StaticResource TitleLarge}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Premium .NET MAUI controls powered by SkiaSharp"
                           Style="{StaticResource BodyMedium}"
                           HorizontalTextAlignment="Center"
                           Opacity="0.7" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Version" Style="{StaticResource LabelSmall}" Opacity="0.6" />
                        <Label Grid.Row="0" Grid.Column="1" Text="2.0.0" Style="{StaticResource BodySmall}" HorizontalTextAlignment="End" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Framework" Style="{StaticResource LabelSmall}" Opacity="0.6" />
                        <Label Grid.Row="1" Grid.Column="1" Text=".NET MAUI" Style="{StaticResource BodySmall}" HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Links Section -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="0">

                    <!-- GitHub -->
                    <Grid Padding="12"
                          ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGitHubTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="📦" FontSize="20" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="View on GitHub" Style="{StaticResource TitleSmall}" Margin="12,0,0,0" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="24" VerticalOptions="Center" Opacity="0.4" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource SurfaceContainer}" />

                    <!-- Documentation -->
                    <Grid Padding="12"
                          ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDocsTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="📚" FontSize="20" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Documentation" Style="{StaticResource TitleSmall}" Margin="12,0,0,0" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="24" VerticalOptions="Center" Opacity="0.4" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Footer -->
            <Label Text="Made with ❤️ for .NET MAUI"
                   Style="{StaticResource BodySmall}"
                   HorizontalTextAlignment="Center"
                   Opacity="0.4"
                   Margin="0,16,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
