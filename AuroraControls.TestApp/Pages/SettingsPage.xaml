<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AuroraControls.TestApp.Pages.SettingsPage"
             Title="Settings"
             BackgroundColor="#0F0F0F">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Header -->
            <Label Text="Settings"
                   TextColor="White"
                   FontSize="28"
                   FontAttributes="Bold"
                   Margin="0,10,0,20" />

            <!-- Appearance Section -->
            <Label Text="Appearance"
                   TextColor="#7C3AED"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,0,0,8" />

            <Border BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 12" Stroke="#2A2A2A" Padding="16">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Dark Mode" TextColor="White" FontSize="16" />
                        <Label Text="Use dark theme" TextColor="#6B7280" FontSize="12" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" 
                            x:Name="DarkModeSwitch"
                            IsToggled="True"
                            OnColor="#7C3AED"
                            ThumbColor="White"
                            Toggled="OnDarkModeToggled" />
                </Grid>
            </Border>

            <!-- About Section -->
            <Label Text="About"
                   TextColor="#EC4899"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,16,0,8" />

            <Border BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 12" Stroke="#2A2A2A" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Version" TextColor="White" FontSize="16" />
                        <Label Grid.Column="1" Text="1.0.0" TextColor="#6B7280" FontSize="16" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#2A2A2A" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Framework" TextColor="White" FontSize="16" />
                        <Label Grid.Column="1" Text=".NET MAUI 9" TextColor="#6B7280" FontSize="16" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#2A2A2A" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="SkiaSharp" TextColor="White" FontSize="16" />
                        <Label Grid.Column="1" Text="3.x" TextColor="#6B7280" FontSize="16" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Credits -->
            <Border BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 12" Stroke="#2A2A2A" Padding="20" Margin="0,16,0,0">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="Aurora Controls"
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Beautiful MAUI Controls"
                           TextColor="#9CA3AF"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />
                    <Label Text="© 2025 TheEightBot"
                           TextColor="#4B5563"
                           FontSize="12"
                           HorizontalTextAlignment="Center"
                           Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
