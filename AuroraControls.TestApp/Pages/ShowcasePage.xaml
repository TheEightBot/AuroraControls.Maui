<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AuroraControls.TestApp.Pages.ShowcasePage"
             Title="Showcase"
             BackgroundColor="#0F0F0F">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" Margin="0,20,0,10">
                <Label Text="Aurora Controls"
                       TextColor="White"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Label Text="Beautiful MAUI Controls"
                       TextColor="#9CA3AF"
                       FontSize="16"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Featured Control Card -->
            <Border BackgroundColor="#1A1A1A"
                    StrokeShape="RoundRectangle 16"
                    Stroke="#2A2A2A"
                    Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="🎨 Featured Control"
                           TextColor="#7C3AED"
                           FontSize="14"
                           FontAttributes="Bold" />

                    <Border BackgroundColor="#262626"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent"
                            HeightRequest="120"
                            Padding="20">
                        <Label Text="Gradient Pill Button"
                               TextColor="White"
                               FontSize="20"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Border>

                    <Label Text="Create beautiful gradient buttons with customizable colors, shadows, and animations."
                           TextColor="#9CA3AF"
                           FontSize="14"
                           LineBreakMode="WordWrap" />

                    <Button Text="Explore →"
                            BackgroundColor="#7C3AED"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="44"
                            Clicked="OnExploreClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Popular Controls -->
            <Label Text="Popular Controls"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <HorizontalStackLayout Spacing="12">
                <Border BackgroundColor="#1A1A1A"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#2A2A2A"
                        WidthRequest="100"
                        HeightRequest="100"
                        Padding="12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleBoxTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="✓"
                               TextColor="#22C55E"
                               FontSize="24"
                               HorizontalTextAlignment="Center" />
                        <Label Text="ToggleBox"
                               TextColor="White"
                               FontSize="12"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#1A1A1A"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#2A2A2A"
                        WidthRequest="100"
                        HeightRequest="100"
                        Padding="12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCalendarTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="📅"
                               FontSize="24"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Calendar"
                               TextColor="White"
                               FontSize="12"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#1A1A1A"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#2A2A2A"
                        WidthRequest="100"
                        HeightRequest="100"
                        Padding="12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnConfettiTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="🎉"
                               FontSize="24"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Confetti"
                               TextColor="White"
                               FontSize="12"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </HorizontalStackLayout>

            <!-- Version Info -->
            <Label Text="Version 1.0 • .NET MAUI 9"
                   TextColor="#4B5563"
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
