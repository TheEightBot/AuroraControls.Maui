<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:aurora="http://auroracontrols.maui/controls"
             xmlns:controls="clr-namespace:AuroraControls.TestApp.Controls"
             xmlns:editors="clr-namespace:AuroraControls.TestApp.Controls.PropertyEditors"
             x:Class="AuroraControls.TestApp.Pages.Chips.ChipGroupDemoPage"
             Title="Chip Group"
             BackgroundColor="{AppThemeBinding Light={StaticResource Light.PageBackground}, Dark={StaticResource Dark.PageBackground}}">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Light.Surface}, Dark={StaticResource Dark.Surface}}"
                StrokeThickness="0"
                Padding="20,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border BackgroundColor="#8B5CF6"
                        StrokeThickness="0"
                        HeightRequest="40"
                        WidthRequest="40"
                        Padding="8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label Text="🏷️"
                           FontSize="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="16,0,0,0">
                    <Label Text="Chip Group"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Light.TextPrimary}, Dark={StaticResource Dark.TextPrimary}}"/>
                    <Label Text="Tag-style chip selection"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Light.TextSecondary}, Dark={StaticResource Dark.TextSecondary}}"/>
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        Text="Add Chip"
                        BackgroundColor="#22C55E"
                        TextColor="{AppThemeBinding Light={StaticResource Light.TextPrimary}, Dark={StaticResource Dark.TextPrimary}}"
                        FontSize="12"
                        HeightRequest="36"
                        Padding="12,0"
                        CornerRadius="8"
                        Clicked="OnAddChipClicked"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="20">

                <!-- Live Preview Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Light.Surface}, Dark={StaticResource Dark.Surface}}"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Light.Border}, Dark={StaticResource Dark.Border}}"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="LIVE PREVIEW"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Light.TextTertiary}, Dark={StaticResource Dark.TextTertiary}}"
                               CharacterSpacing="1"/>

                        <!-- ChipGroup Control -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Light.SurfaceVariant}, Dark={StaticResource Dark.SurfaceVariant}}"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Light.BorderStrong}, Dark={StaticResource Dark.BorderStrong}}"
                                Padding="16"
                                MinimumHeightRequest="100">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <aurora:ChipGroup x:Name="PreviewChipGroup"
                                              Spacing="8"
                                              ChipTapped="OnChipTapped">
                                <aurora:Chip Text="Swift"
                                             Value="swift"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource Light.SliderTrack}, Dark={StaticResource Dark.SliderTrack}}"
                                             ToggledBackgroundColor="#8B5CF6"
                                             TextColor="#E5E7EB"
                                             ToggledFontColor="White"
                                             CornerRadius="16"/>
                                <aurora:Chip Text="Kotlin"
                                             Value="kotlin"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource Light.SliderTrack}, Dark={StaticResource Dark.SliderTrack}}"
                                             ToggledBackgroundColor="#8B5CF6"
                                             TextColor="#E5E7EB"
                                             ToggledFontColor="White"
                                             CornerRadius="16"/>
                                <aurora:Chip Text=".NET MAUI"
                                             Value="maui"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource Light.SliderTrack}, Dark={StaticResource Dark.SliderTrack}}"
                                             ToggledBackgroundColor="#8B5CF6"
                                             TextColor="#E5E7EB"
                                             ToggledFontColor="White"
                                             CornerRadius="16"/>
                                <aurora:Chip Text="Flutter"
                                             Value="flutter"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource Light.SliderTrack}, Dark={StaticResource Dark.SliderTrack}}"
                                             ToggledBackgroundColor="#8B5CF6"
                                             TextColor="#E5E7EB"
                                             ToggledFontColor="White"
                                             CornerRadius="16"/>
                                <aurora:Chip Text="React Native"
                                             Value="react"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource Light.SliderTrack}, Dark={StaticResource Dark.SliderTrack}}"
                                             ToggledBackgroundColor="#8B5CF6"
                                             TextColor="#E5E7EB"
                                             ToggledFontColor="White"
                                             CornerRadius="16"/>
                            </aurora:ChipGroup>
                        </Border>

                        <!-- Selection Display -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Light.SurfaceVariant}, Dark={StaticResource Dark.SurfaceVariant}}"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Selected:"
                                       TextColor="{AppThemeBinding Light={StaticResource Light.TextSecondary}, Dark={StaticResource Dark.TextSecondary}}"
                                       FontSize="14"
                                       VerticalOptions="Center"/>
                                <Label x:Name="SelectedChipsLabel"
                                       Text="None"
                                       TextColor="#8B5CF6"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Presets -->
                <controls:PresetSelector x:Name="PresetSelector"
                                         Label="Style Presets"
                                         PresetChanged="OnPresetSelected"/>

                <!-- Selection Mode -->
                <controls:ExpandableSection Title="✅ Selection Mode" IsExpanded="True">
                    <VerticalStackLayout Spacing="12" Padding="0,8">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button x:Name="MultiSelectBtn"
                                    Text="Multi-Select"
                                    BackgroundColor="#8B5CF6"
                                    TextColor="{AppThemeBinding Light={StaticResource Light.TextPrimary}, Dark={StaticResource Dark.TextPrimary}}"
                                    FontSize="13"
                                    HeightRequest="44"
                                    CornerRadius="8"
                                    Clicked="OnSelectionModeChanged"/>
                            <Button x:Name="SingleSelectBtn"
                                    Grid.Column="1"
                                    Text="Single-Select"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Light.SliderTrack}, Dark={StaticResource Dark.SliderTrack}}"
                                    TextColor="{AppThemeBinding Light={StaticResource Light.TextPrimary}, Dark={StaticResource Dark.TextPrimary}}"
                                    FontSize="13"
                                    HeightRequest="44"
                                    CornerRadius="8"
                                    Clicked="OnSelectionModeChanged"/>
                        </Grid>

                        <editors:ToggleEditor x:Name="ChipSelectionDetectionToggle"
                                              Label="Chip Selection Detection"
                                              Value="True"
                                              ValueChanged="OnChipSelectionDetectionChanged"/>

                        <Button Text="Clear All Selections"
                                BackgroundColor="#EF4444"
                                TextColor="{AppThemeBinding Light={StaticResource Light.TextPrimary}, Dark={StaticResource Dark.TextPrimary}}"
                                FontSize="14"
                                HeightRequest="44"
                                CornerRadius="8"
                                Clicked="OnClearSelectionsClicked"/>
                    </VerticalStackLayout>
                </controls:ExpandableSection>

                <!-- Layout Settings -->
                <controls:ExpandableSection Title="📐 Layout" IsExpanded="True">
                    <VerticalStackLayout Spacing="12" Padding="0,8">
                        <editors:SliderEditor x:Name="SpacingSlider"
                                              Label="Spacing"
                                              Minimum="0"
                                              Maximum="24"
                                              Value="8"
                                              ValueChanged="OnSpacingChanged"/>

                        <editors:ToggleEditor x:Name="ScrollableToggle"
                                              Label="Scrollable (Horizontal)"
                                              ValueChanged="OnScrollableChanged"/>

                        <editors:SliderEditor x:Name="MaxRowsSlider"
                                              Label="Max Rows Before Overflow (-1 = unlimited)"
                                              Minimum="-1"
                                              Maximum="5"
                                              Value="-1"
                                              ValueChanged="OnMaxRowsChanged"/>

                        <!-- Overflow Status -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Light.SurfaceVariant}, Dark={StaticResource Dark.SurfaceVariant}}"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Overflow:"
                                       TextColor="{AppThemeBinding Light={StaticResource Light.TextSecondary}, Dark={StaticResource Dark.TextSecondary}}"
                                       FontSize="14"
                                       VerticalOptions="Center"/>
                                <Label x:Name="OverflowLabel"
                                       Text="No"
                                       TextColor="#22C55E"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </controls:ExpandableSection>

                <!-- Individual Chip Settings -->
                <controls:ExpandableSection Title="🎨 Chip Appearance">
                    <VerticalStackLayout Spacing="12" Padding="0,8">
                        <editors:ColorPickerEditor x:Name="ChipBackgroundPicker"
                                                   Label="Chip Background"
                                                   ColorChanged="OnChipColorChanged"/>
                        <editors:ColorPickerEditor x:Name="ChipToggledBackgroundPicker"
                                                   Label="Toggled Background"
                                                   ColorChanged="OnChipColorChanged"/>
                        <editors:ColorPickerEditor x:Name="ChipTextColorPicker"
                                                   Label="Text Color"
                                                   ColorChanged="OnChipColorChanged"/>
                        <editors:ColorPickerEditor x:Name="ChipToggledTextColorPicker"
                                                   Label="Toggled Text Color"
                                                   ColorChanged="OnChipColorChanged"/>
                        <editors:SliderEditor x:Name="CornerRadiusSlider"
                                              Label="Corner Radius"
                                              Minimum="0"
                                              Maximum="24"
                                              Value="16"
                                              ValueChanged="OnCornerRadiusChanged"/>
                    </VerticalStackLayout>
                </controls:ExpandableSection>

                <!-- Chip Features -->
                <controls:ExpandableSection Title="⚙️ Chip Features">
                    <VerticalStackLayout Spacing="12" Padding="0,8">
                        <editors:ToggleEditor x:Name="RemovableToggle"
                                              Label="Removable Chips"
                                              ValueChanged="OnRemovableChanged"/>

                        <Label Text="Chip Shape"
                               TextColor="{AppThemeBinding Light={StaticResource Light.TextSecondary}, Dark={StaticResource Dark.TextSecondary}}"
                               FontSize="13"/>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button x:Name="StandardShapeBtn"
                                    Text="Standard"
                                    BackgroundColor="#8B5CF6"
                                    TextColor="{AppThemeBinding Light={StaticResource Light.TextPrimary}, Dark={StaticResource Dark.TextPrimary}}"
                                    FontSize="12"
                                    HeightRequest="40"
                                    CornerRadius="8"
                                    Clicked="OnShapeChanged"/>
                            <Button x:Name="RectangleShapeBtn"
                                    Grid.Column="1"
                                    Text="Rectangle"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Light.SliderTrack}, Dark={StaticResource Dark.SliderTrack}}"
                                    TextColor="{AppThemeBinding Light={StaticResource Light.TextPrimary}, Dark={StaticResource Dark.TextPrimary}}"
                                    FontSize="12"
                                    HeightRequest="40"
                                    CornerRadius="8"
                                    Clicked="OnShapeChanged"/>
                            <Button x:Name="RoundedShapeBtn"
                                    Grid.Column="2"
                                    Text="Rounded"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Light.SliderTrack}, Dark={StaticResource Dark.SliderTrack}}"
                                    TextColor="{AppThemeBinding Light={StaticResource Light.TextPrimary}, Dark={StaticResource Dark.TextPrimary}}"
                                    FontSize="12"
                                    HeightRequest="40"
                                    CornerRadius="8"
                                    Clicked="OnShapeChanged"/>
                        </Grid>
                    </VerticalStackLayout>
                </controls:ExpandableSection>

                <!-- Scroll Controls -->
                <controls:ExpandableSection Title="📜 Scroll Controls" IsExpanded="False">
                    <VerticalStackLayout Spacing="12" Padding="0,8">
                        <Label Text="Only available when Scrollable is enabled"
                               TextColor="{AppThemeBinding Light={StaticResource Light.TextTertiary}, Dark={StaticResource Dark.TextTertiary}}"
                               FontSize="12"
                               FontAttributes="Italic"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Scroll to Start"
                                    BackgroundColor="#3B82F6"
                                    TextColor="{AppThemeBinding Light={StaticResource Light.TextPrimary}, Dark={StaticResource Dark.TextPrimary}}"
                                    FontSize="13"
                                    HeightRequest="44"
                                    CornerRadius="8"
                                    Clicked="OnScrollToStartClicked"/>
                            <Button Grid.Column="1"
                                    Text="Scroll to End"
                                    BackgroundColor="#3B82F6"
                                    TextColor="{AppThemeBinding Light={StaticResource Light.TextPrimary}, Dark={StaticResource Dark.TextPrimary}}"
                                    FontSize="13"
                                    HeightRequest="44"
                                    CornerRadius="8"
                                    Clicked="OnScrollToEndClicked"/>
                        </Grid>
                    </VerticalStackLayout>
                </controls:ExpandableSection>

                <!-- Bottom spacing -->
                <BoxView HeightRequest="40" Color="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
