<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AuroraControls.TestApp.Pages.EffectsPage"
             Title="Effects"
             BackgroundColor="#0F0F0F">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Header -->
            <Label Text="Visual Effects"
                   TextColor="White"
                   FontSize="28"
                   FontAttributes="Bold"
                   Margin="0,10,0,20" />

            <!-- Image Processing Section -->
            <Label Text="🖼️ Image Processing"
                   TextColor="#3B82F6"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,8,0,4" />

            <Border x:Name="ImageProcessingCard" BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 12" Stroke="#2A2A2A" Padding="16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnImageProcessingTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="4,*,Auto">
                    <BoxView Color="#3B82F6" CornerRadius="2" WidthRequest="4" />
                    <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                        <Label Text="Image Processing" TextColor="White" FontSize="16" FontAttributes="Bold" />
                        <Label Text="Blur, grayscale, sepia, and more" TextColor="#6B7280" FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="→" TextColor="#6B7280" FontSize="18" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Platform Effects Section -->
            <Label Text="📱 Platform Effects"
                   TextColor="#EC4899"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,16,0,4" />

            <Border x:Name="KeyboardEffectCard" BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 12" Stroke="#2A2A2A" Padding="16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnKeyboardEffectTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="4,*,Auto">
                    <BoxView Color="#EC4899" CornerRadius="2" WidthRequest="4" />
                    <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                        <Label Text="Keyboard Return Key" TextColor="White" FontSize="16" FontAttributes="Bold" />
                        <Label Text="Customize keyboard return button" TextColor="#6B7280" FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="→" TextColor="#6B7280" FontSize="18" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border x:Name="DoneButtonCard" BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 12" Stroke="#2A2A2A" Padding="16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDoneButtonTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="4,*,Auto">
                    <BoxView Color="#14B8A6" CornerRadius="2" WidthRequest="4" />
                    <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                        <Label Text="Keyboard Done Button" TextColor="White" FontSize="16" FontAttributes="Bold" />
                        <Label Text="Add done button to keyboard" TextColor="#6B7280" FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="→" TextColor="#6B7280" FontSize="18" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border x:Name="SafeAreaCard" BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 12" Stroke="#2A2A2A" Padding="16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSafeAreaTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="4,*,Auto">
                    <BoxView Color="#F59E0B" CornerRadius="2" WidthRequest="4" />
                    <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                        <Label Text="Safe Area Effect" TextColor="White" FontSize="16" FontAttributes="Bold" />
                        <Label Text="Respect device safe areas" TextColor="#6B7280" FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="→" TextColor="#6B7280" FontSize="18" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Bottom spacing -->
            <BoxView HeightRequest="20" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
