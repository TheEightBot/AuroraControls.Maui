<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:AuroraControls.TestApp.Pages"
             x:Class="AuroraControls.TestApp.Pages.ControlsListPage"
             Title="Controls"
             Style="{StaticResource DemoPageStyle}"
             BackgroundColor="{StaticResource SurfaceDim}">

    <CollectionView x:Name="ControlsCollection"
                    SelectionMode="Single"
                    SelectionChanged="OnControlSelected">
        <CollectionView.ItemsSource>
            <x:Array Type="{x:Type x:String}">
                <!-- Placeholder - will be replaced with proper model -->
            </x:Array>
        </CollectionView.ItemsSource>

        <CollectionView.Header>
            <VerticalStackLayout Padding="16" Spacing="12">
                <!-- Search Bar -->
                <Border Style="{StaticResource CardStyle}" Padding="8">
                    <SearchBar x:Name="SearchBar"
                               Placeholder="Search controls..."
                               TextChanged="OnSearchTextChanged"
                               BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate x:DataType="pages:ControlGroup">
                <VerticalStackLayout Padding="16,12">
                    <Label Text="{Binding Name}"
                           Style="{StaticResource TitleMedium}"
                           TextColor="{StaticResource AuroraPurple}" />
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="pages:ControlItem">
                <Border Style="{StaticResource CardStyle}"
                        Margin="16,0,16,8">
                    <Grid Padding="12"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">

                        <!-- Icon -->
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource SurfaceContainer}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="Transparent"
                                HeightRequest="44"
                                WidthRequest="44">
                            <Label Text="{Binding Icon}"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Title & Description -->
                        <VerticalStackLayout Grid.Column="1"
                                            VerticalOptions="Center"
                                            Spacing="4">
                            <Label Text="{Binding Name}"
                                   Style="{StaticResource TitleSmall}" />
                            <Label Text="{Binding Description}"
                                   Style="{StaticResource BodySmall}"
                                   Opacity="0.6"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <!-- Chevron -->
                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="24"
                               VerticalOptions="Center"
                               Opacity="0.4" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.EmptyView>
            <VerticalStackLayout VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Spacing="12">
                <Label Text="🔍" FontSize="48" HorizontalTextAlignment="Center" />
                <Label Text="No controls found"
                       Style="{StaticResource TitleMedium}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Try a different search term"
                       Style="{StaticResource BodyMedium}"
                       HorizontalTextAlignment="Center"
                       Opacity="0.6" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>
    </CollectionView>
</ContentPage>
