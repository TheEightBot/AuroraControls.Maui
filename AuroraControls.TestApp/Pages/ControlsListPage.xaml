<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AuroraControls.TestApp.Pages.ControlsListPage"
             x:Name="this"
             Title="Controls"
             BackgroundColor="#0F0F0F">

    <Grid RowDefinitions="Auto,*">
        
        <!-- Search Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,20,20,0" Spacing="12">
            
            <Label Text="All Controls"
                   TextColor="White"
                   FontSize="28"
                   FontAttributes="Bold" />
            
            <!-- Search Bar -->
            <Border BackgroundColor="#1A1A1A" 
                    StrokeShape="RoundRectangle 12" 
                    Stroke="#2A2A2A" 
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Grid.Column="0" 
                           Text="🔍" 
                           FontSize="16" 
                           VerticalOptions="Center" 
                           Margin="0,0,8,0" />
                    <Entry Grid.Column="1"
                           x:Name="SearchEntry"
                           Placeholder="Search controls..."
                           PlaceholderColor="#6B7280"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           TextChanged="OnSearchTextChanged" />
                    <Label Grid.Column="2"
                           x:Name="ClearButton"
                           Text="✕"
                           FontSize="14"
                           TextColor="#6B7280"
                           VerticalOptions="Center"
                           IsVisible="False">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClearSearchTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>
            
            <!-- Results count -->
            <Label x:Name="ResultsLabel"
                   Text=""
                   TextColor="#6B7280"
                   FontSize="12"
                   IsVisible="False" />
        </VerticalStackLayout>

        <!-- Controls List -->
        <CollectionView Grid.Row="1"
                        x:Name="ControlsCollection"
                        ItemsSource="{Binding FilteredControls, Source={x:Reference this}}"
                        SelectionMode="Single"
                        SelectionChanged="OnControlSelected"
                        Margin="20,12,20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1A1A1A" 
                            StrokeShape="RoundRectangle 12" 
                            Stroke="#2A2A2A" 
                            Padding="16"
                            Margin="0,0,0,8">
                        <Grid ColumnDefinitions="4,*,Auto">
                            <BoxView Color="{Binding AccentColor}" CornerRadius="2" WidthRequest="4" />
                            <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                <Label Text="{Binding Name}" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                <Label Text="{Binding Description}" TextColor="#6B7280" FontSize="12" />
                                <Label Text="{Binding Category}" TextColor="#9CA3AF" FontSize="10" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="→" TextColor="#6B7280" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="40">
                    <Label Text="🔍" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="No controls found" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,12,0,4" />
                    <Label Text="Try a different search term" TextColor="#6B7280" FontSize="14" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            
            <CollectionView.Footer>
                <BoxView HeightRequest="100" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
        
    </Grid>

</ContentPage>
