<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AuroraControls.TestApp.KeyboardToolbarTestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ap="clr-namespace:AuroraControls.AttachedProperties;assembly=AuroraControlsMaui"
    Title="Keyboard Toolbar">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- STATUS INDICATOR -->
            <Border
                BackgroundColor="{Binding StatusBackground}"
                Padding="12,8"
                StrokeShape="RoundRectangle 10">
                <Label
                    Text="{Binding StatusText}"
                    TextColor="{Binding StatusColor}"
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalTextAlignment="Center" />
            </Border>

            <!-- CONFIGURATION PANEL -->
            <Border Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Live Configuration" FontAttributes="Bold" FontSize="15" />

                    <!-- Show Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Show Keyboard Toolbar" VerticalOptions="Center" FontSize="14" />
                        <Switch Grid.Column="1" IsToggled="{Binding ShowToolbar}" />
                    </Grid>

                    <!-- Button Style -->
                    <Label Text="Button Style" FontSize="13" TextColor="Gray" />
                    <Picker ItemsSource="{Binding ButtonStyleOptions}" SelectedIndex="{Binding ButtonStyleIndex}" Title="Select button style" />

                    <!-- Done Title -->
                    <Label Text="Button Title  (Text style only)" FontSize="13" TextColor="Gray" />
                    <Entry Text="{Binding DoneTitle}" Placeholder="e.g. Done, Close, Dismiss" ClearButtonVisibility="WhileEditing" />

                    <!-- Title Color -->
                    <Label Text="Title Color  (Text style only)" FontSize="13" TextColor="Gray" />
                    <Picker ItemsSource="{Binding TitleColorOptions}" SelectedIndex="{Binding TitleColorIndex}" Title="Select title color" />

                    <!-- Background Color -->
                    <Label Text="Toolbar Background Color" FontSize="13" TextColor="Gray" />
                    <Picker ItemsSource="{Binding BackgroundColorOptions}" SelectedIndex="{Binding BackgroundColorIndex}" Title="Select background color" />

                    <!-- Height -->
                    <Label Text="{Binding HeightLabel}" FontSize="13" TextColor="Gray" />
                    <Slider Value="{Binding ToolbarHeight}" Minimum="0" Maximum="120" />

                    <!-- Font Size -->
                    <Label Text="{Binding FontSizeLabel}" FontSize="13" TextColor="Gray" />
                    <Slider Value="{Binding LiveFontSize}" Minimum="0" Maximum="36" />

                </VerticalStackLayout>
            </Border>

            <!-- LIVE TEST — Entry -->
            <Border Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Live Test · Entry" FontAttributes="Bold" FontSize="14" />
                    <Label Text="Adjust config above, then tap this field to see the toolbar." FontSize="12" TextColor="Gray" />
                    <Entry
                        Text="{Binding LiveEntryText}"
                        Placeholder="Tap me to see the toolbar"
                        ap:KeyboardToolbar.Show="{Binding ShowToolbar}"
                        ap:KeyboardToolbar.ButtonStyle="{Binding SelectedButtonStyle}"
                        ap:KeyboardToolbar.Title="{Binding DoneTitle}"
                        ap:KeyboardToolbar.TitleColor="{Binding SelectedTitleColor}"
                        ap:KeyboardToolbar.BackgroundColor="{Binding SelectedBackgroundColor}"
                        ap:KeyboardToolbar.Height="{Binding ToolbarHeight}"
                        ap:KeyboardToolbar.FontSize="{Binding LiveFontSize}" />
                </VerticalStackLayout>
            </Border>

            <!-- LIVE TEST — Editor -->
            <Border Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Live Test · Editor" FontAttributes="Bold" FontSize="14" />
                    <Label Text="Multiline editor — also supports the toolbar." FontSize="12" TextColor="Gray" />
                    <Editor
                        Text="{Binding LiveEditorText}"
                        Placeholder="Tap me to see the toolbar"
                        HeightRequest="80"
                        ap:KeyboardToolbar.Show="{Binding ShowToolbar}"
                        ap:KeyboardToolbar.ButtonStyle="{Binding SelectedButtonStyle}"
                        ap:KeyboardToolbar.Title="{Binding DoneTitle}"
                        ap:KeyboardToolbar.TitleColor="{Binding SelectedTitleColor}"
                        ap:KeyboardToolbar.BackgroundColor="{Binding SelectedBackgroundColor}"
                        ap:KeyboardToolbar.Height="{Binding ToolbarHeight}"
                        ap:KeyboardToolbar.FontSize="{Binding LiveFontSize}" />
                </VerticalStackLayout>
            </Border>

            <!-- STATIC EXAMPLES -->
            <Label Text="Static Examples  (effect always ON)" FontAttributes="Bold" FontSize="15" Margin="0,8,0,0" />

            <!-- A: Orange "Done" — unmistakably custom (default MAUI bar is blue "Done") -->
            <Border Padding="12" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="A · Effect ON · Orange title 'Done' (custom)" FontSize="12" TextColor="Gray" />
                    <Entry Placeholder="Tap to test"
                           ap:KeyboardToolbar.Show="True"
                           ap:KeyboardToolbar.TitleColor="Orange" />
                </VerticalStackLayout>
            </Border>

            <!-- B: Close / Red -->
            <Border Padding="12" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="B · title='Close' · Red" FontSize="12" TextColor="Gray" />
                    <Entry Placeholder="Tap to test"
                           ap:KeyboardToolbar.Show="True"
                           ap:KeyboardToolbar.Title="Close"
                           ap:KeyboardToolbar.TitleColor="OrangeRed"
                           ap:KeyboardToolbar.FontSize="17" />
                </VerticalStackLayout>
            </Border>

            <!-- C: Dismiss / Green / Teal bg -->
            <Border Padding="12" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="C · 'Dismiss' · Green · Teal background" FontSize="12" TextColor="Gray" />
                    <Entry Placeholder="Tap to test"
                           ap:KeyboardToolbar.Show="True"
                           ap:KeyboardToolbar.Title="Dismiss"
                           ap:KeyboardToolbar.TitleColor="White"
                           ap:KeyboardToolbar.BackgroundColor="#CC333333" />
                </VerticalStackLayout>
            </Border>

            <!-- D: SystemCheckmark -->
            <Border Padding="12" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="D · SystemCheckmark style (iOS 26 circular button)" FontSize="12" TextColor="Gray" />
                    <Entry Placeholder="Tap to test"
                           ap:KeyboardToolbar.Show="True"
                           ap:KeyboardToolbar.ButtonStyle="SystemCheckmark" />
                </VerticalStackLayout>
            </Border>

            <!-- E: Fixed height 80 -->
            <Border Padding="12" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="E · Fixed Height=80" FontSize="12" TextColor="Gray" />
                    <Entry Placeholder="Tap to test"
                           ap:KeyboardToolbar.Show="True"
                           ap:KeyboardToolbar.Height="64"
                           ap:KeyboardToolbar.Title="Done ✓" />
                </VerticalStackLayout>
            </Border>

            <!-- F: Large font -->
            <Border Padding="12" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="F · FontSize=22" FontSize="12" TextColor="Gray" />
                    <Entry Placeholder="Tap to test"
                           ap:KeyboardToolbar.Show="True"
                           ap:KeyboardToolbar.FontSize="22" />
                </VerticalStackLayout>
            </Border>

            <!-- G: Dark background / White title -->
            <Border Padding="12" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="G · Dark bg · White title" FontSize="12" TextColor="Gray" />
                    <Entry Placeholder="Tap to test"
                           ap:KeyboardToolbar.Show="True"
                           ap:KeyboardToolbar.BackgroundColor="#CC222222"
                           ap:KeyboardToolbar.TitleColor="White" />
                </VerticalStackLayout>
            </Border>

            <!-- H: Editor with Save -->
            <Border Padding="12" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="H · Editor · title='Save'" FontSize="12" TextColor="Gray" />
                    <Editor Placeholder="Tap to test"
                            HeightRequest="80"
                            ap:KeyboardToolbar.Show="True"
                            ap:KeyboardToolbar.Title="Save" />
                </VerticalStackLayout>
            </Border>

            <!-- I: Control — no effect -->
            <Border Padding="12" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="I · No toolbar (control group — effect OFF)" FontSize="12" TextColor="Gray" />
                    <Entry Placeholder="No toolbar on this one" ap:KeyboardToolbar.Show="False" />
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="32" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
