<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:aurora="http://auroracontrols.maui/controls"
             xmlns:editors="clr-namespace:AuroraControls.TestApp.Controls.PropertyEditors"
             xmlns:controls="clr-namespace:AuroraControls.TestApp.Controls"
             x:Class="AuroraControls.TestApp.SvgImageButtonTestPage"
             Title="SVG Image Button"
             BackgroundColor="#0F0F0F">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            
            <!-- Header -->
            <Label Text="SVG Image Button"
                   TextColor="White"
                   FontSize="28"
                   FontAttributes="Bold" />
            <Label Text="Buttons with embedded SVG images and customizable backgrounds"
                   TextColor="#6B7280"
                   FontSize="14"
                   Margin="0,-8,0,8" />
            
            <!-- Live Preview -->
            <Border BackgroundColor="#1A1A1A" 
                    StrokeShape="RoundRectangle 16" 
                    Stroke="#2A2A2A" 
                    Padding="24"
                    HeightRequest="200">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                    <aurora:SvgImageButton x:Name="PreviewButton"
                                           EmbeddedImageName="{Binding SelectedImage}"
                                           BackgroundShape="{Binding SelectedShape}"
                                           BackgroundColor="{Binding ButtonBackgroundColor}"
                                           OverlayColor="{Binding OverlayColor}"
                                           CornerRadius="{Binding CornerRadius}"
                                           HeightRequest="{Binding ButtonSize}"
                                           WidthRequest="{Binding ButtonSize}"
                                           HorizontalOptions="Center"
                                           Clicked="OnButtonClicked" />
                    <Label x:Name="StatusLabel"
                           Text="Tap to test"
                           TextColor="#6B7280"
                           FontSize="12"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            
            <!-- Presets -->
            <controls:PresetSelector x:Name="PresetSelector"
                                     Label="Quick Presets"
                                     ShowLabel="True" />
            
            <!-- Properties Section -->
            <controls:ExpandableSection Title="Image &amp; Shape" Icon="🖼️" IsExpanded="True">
                <controls:ExpandableSection.SectionContent>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Label Text="Image" TextColor="White" VerticalOptions="Center" />
                            <Picker x:Name="ImagePicker"
                                    TextColor="White"
                                    BackgroundColor="#2A2A2A"
                                    SelectedIndexChanged="OnImageChanged">
                                <Picker.Items>
                                    <x:String>splatoon.svg</x:String>
                                    <x:String>triforce.svg</x:String>
                                    <x:String>more.svg</x:String>
                                    <x:String>logo.svg</x:String>
                                    <x:String>dollar_sign.svg</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Label Text="Shape" TextColor="White" VerticalOptions="Center" />
                            <Picker x:Name="ShapePicker"
                                    TextColor="White"
                                    BackgroundColor="#2A2A2A"
                                    SelectedIndexChanged="OnShapeChanged">
                                <Picker.Items>
                                    <x:String>None</x:String>
                                    <x:String>Square</x:String>
                                    <x:String>Circular</x:String>
                                    <x:String>RoundedSquare</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>
                    </VerticalStackLayout>
                </controls:ExpandableSection.SectionContent>
            </controls:ExpandableSection>
            
            <controls:ExpandableSection Title="Colors" Icon="🎨" IsExpanded="False">
                <controls:ExpandableSection.SectionContent>
                    <VerticalStackLayout Spacing="8">
                        <editors:ColorPickerEditor Label="Background Color"
                                                   SelectedColor="{Binding ButtonBackgroundColor}" />
                        <editors:ColorPickerEditor Label="Overlay Color"
                                                   SelectedColor="{Binding OverlayColor}" />
                    </VerticalStackLayout>
                </controls:ExpandableSection.SectionContent>
            </controls:ExpandableSection>
            
            <controls:ExpandableSection Title="Size &amp; Shape" Icon="📐" IsExpanded="False">
                <controls:ExpandableSection.SectionContent>
                    <VerticalStackLayout Spacing="8">
                        <editors:SliderEditor Label="Button Size"
                                              Value="{Binding ButtonSize}"
                                              Minimum="40"
                                              Maximum="150"
                                              Unit="px" />
                        <editors:SliderEditor Label="Corner Radius"
                                              Value="{Binding CornerRadius}"
                                              Minimum="0"
                                              Maximum="50"
                                              Unit="px" />
                    </VerticalStackLayout>
                </controls:ExpandableSection.SectionContent>
            </controls:ExpandableSection>
            
            <!-- Background Shapes Examples -->
            <Label Text="Background Shapes"
                   TextColor="#7C3AED"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,16,0,8" />
            
            <FlexLayout Wrap="Wrap" JustifyContent="SpaceEvenly" AlignItems="Center">
                <VerticalStackLayout Margin="8">
                    <aurora:SvgImageButton EmbeddedImageName="splatoon.svg"
                                           BackgroundShape="None"
                                           HeightRequest="70"
                                           WidthRequest="70"
                                           Clicked="OnButtonClicked" />
                    <Label Text="None" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center" Margin="0,4,0,0" />
                </VerticalStackLayout>
                
                <VerticalStackLayout Margin="8">
                    <aurora:SvgImageButton EmbeddedImageName="triforce.svg"
                                           BackgroundShape="Square"
                                           BackgroundColor="#3B82F6"
                                           HeightRequest="70"
                                           WidthRequest="70"
                                           Clicked="OnButtonClicked" />
                    <Label Text="Square" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center" Margin="0,4,0,0" />
                </VerticalStackLayout>
                
                <VerticalStackLayout Margin="8">
                    <aurora:SvgImageButton EmbeddedImageName="more.svg"
                                           BackgroundShape="Circular"
                                           BackgroundColor="#22C55E"
                                           HeightRequest="70"
                                           WidthRequest="70"
                                           Clicked="OnButtonClicked" />
                    <Label Text="Circular" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center" Margin="0,4,0,0" />
                </VerticalStackLayout>
                
                <VerticalStackLayout Margin="8">
                    <aurora:SvgImageButton EmbeddedImageName="logo.svg"
                                           BackgroundShape="RoundedSquare"
                                           BackgroundColor="#EC4899"
                                           CornerRadius="16"
                                           HeightRequest="70"
                                           WidthRequest="70"
                                           Clicked="OnButtonClicked" />
                    <Label Text="Rounded" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </FlexLayout>
            
            <!-- Overlay Colors Examples -->
            <Label Text="Overlay Colors"
                   TextColor="#7C3AED"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,16,0,8" />
            
            <FlexLayout Wrap="Wrap" JustifyContent="SpaceEvenly" AlignItems="Center">
                <VerticalStackLayout Margin="8">
                    <aurora:SvgImageButton EmbeddedImageName="splatoon.svg"
                                           BackgroundShape="Circular"
                                           BackgroundColor="#1F2937"
                                           OverlayColor="#EF4444"
                                           HeightRequest="70"
                                           WidthRequest="70"
                                           Clicked="OnButtonClicked" />
                    <Label Text="Red" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center" Margin="0,4,0,0" />
                </VerticalStackLayout>
                
                <VerticalStackLayout Margin="8">
                    <aurora:SvgImageButton EmbeddedImageName="triforce.svg"
                                           BackgroundShape="Circular"
                                           BackgroundColor="#1F2937"
                                           OverlayColor="#3B82F6"
                                           HeightRequest="70"
                                           WidthRequest="70"
                                           Clicked="OnButtonClicked" />
                    <Label Text="Blue" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center" Margin="0,4,0,0" />
                </VerticalStackLayout>
                
                <VerticalStackLayout Margin="8">
                    <aurora:SvgImageButton EmbeddedImageName="more.svg"
                                           BackgroundShape="Circular"
                                           BackgroundColor="#1F2937"
                                           OverlayColor="#22C55E"
                                           HeightRequest="70"
                                           WidthRequest="70"
                                           Clicked="OnButtonClicked" />
                    <Label Text="Green" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center" Margin="0,4,0,0" />
                </VerticalStackLayout>
                
                <VerticalStackLayout Margin="8">
                    <aurora:SvgImageButton EmbeddedImageName="logo.svg"
                                           BackgroundShape="Circular"
                                           BackgroundColor="#1F2937"
                                           OverlayColor="#A855F7"
                                           HeightRequest="70"
                                           WidthRequest="70"
                                           Clicked="OnButtonClicked" />
                    <Label Text="Purple" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </FlexLayout>
            
            <!-- Bottom spacing -->
            <BoxView HeightRequest="40" Color="Transparent" />
            
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
