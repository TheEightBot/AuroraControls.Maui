<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:aurora="http://auroracontrols.maui/controls"
             xmlns:editors="clr-namespace:AuroraControls.TestApp.Controls.PropertyEditors"
             xmlns:controls="clr-namespace:AuroraControls.TestApp.Controls"
             x:Class="AuroraControls.TestApp.CupertinoButtonTestPage"
             Title="Cupertino Button"
             BackgroundColor="#0F0F0F">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            
            <!-- Header -->
            <Label Text="Cupertino Button"
                   TextColor="White"
                   FontSize="28"
                   FontAttributes="Bold" />
            <Label Text="iOS-style buttons with customizable appearance"
                   TextColor="#6B7280"
                   FontSize="14"
                   Margin="0,-8,0,8" />
            
            <!-- Live Preview -->
            <Border BackgroundColor="#1A1A1A" 
                    StrokeShape="RoundRectangle 16" 
                    Stroke="#2A2A2A" 
                    Padding="24"
                    HeightRequest="200">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                    <aurora:CupertinoButton x:Name="PreviewButton"
                                            Text="{Binding ButtonText}"
                                            ButtonBackgroundColor="{Binding ButtonBackgroundColor}"
                                            BorderColor="{Binding BorderColor}"
                                            BorderWidth="{Binding BorderWidth}"
                                            BorderRadius="{Binding BorderRadius}"
                                            FontColor="{Binding FontColor}"
                                            FontSize="{Binding FontSize}"
                                            ShadowColor="{Binding ShadowColor}"
                                            ShadowBlurRadius="{Binding ShadowBlurRadius}"
                                            IsIconifiedText="{Binding IsIconifiedText}"
                                            HeightRequest="50"
                                            WidthRequest="200"
                                            HorizontalOptions="Center"
                                            Command="{Binding TestCommand}"
                                            CommandParameter="Preview" />
                    <Label Text="Tap to test"
                           TextColor="#6B7280"
                           FontSize="12"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            
            <!-- Presets -->
            <controls:PresetSelector x:Name="PresetSelector"
                                     Label="Quick Presets"
                                     ShowLabel="True" />
            
            <!-- Properties Section -->
            <controls:ExpandableSection Title="Text &amp; Font" Icon="📝" IsExpanded="True">
                <controls:ExpandableSection.SectionContent>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,2*" ColumnSpacing="12">
                            <Label Text="Button Text" TextColor="White" VerticalOptions="Center" />
                            <Entry Text="{Binding ButtonText}" 
                                   TextColor="White" 
                                   BackgroundColor="#2A2A2A" 
                                   PlaceholderColor="#6B7280" />
                        </Grid>
                        <editors:SliderEditor Label="Font Size"
                                              Value="{Binding FontSize}"
                                              Minimum="8"
                                              Maximum="32"
                                              Unit="pt" />
                        <editors:ToggleEditor Label="Iconified Text"
                                              Description="Treat text as icon font glyph"
                                              Value="{Binding IsIconifiedText}" />
                    </VerticalStackLayout>
                </controls:ExpandableSection.SectionContent>
            </controls:ExpandableSection>
            
            <controls:ExpandableSection Title="Colors" Icon="🎨" IsExpanded="False">
                <controls:ExpandableSection.SectionContent>
                    <VerticalStackLayout Spacing="8">
                        <editors:ColorPickerEditor Label="Background Color"
                                                   SelectedColor="{Binding ButtonBackgroundColor}" />
                        <editors:ColorPickerEditor Label="Font Color"
                                                   SelectedColor="{Binding FontColor}" />
                        <editors:ColorPickerEditor Label="Border Color"
                                                   SelectedColor="{Binding BorderColor}" />
                        <editors:ColorPickerEditor Label="Shadow Color"
                                                   SelectedColor="{Binding ShadowColor}" />
                    </VerticalStackLayout>
                </controls:ExpandableSection.SectionContent>
            </controls:ExpandableSection>
            
            <controls:ExpandableSection Title="Border &amp; Shape" Icon="⬜" IsExpanded="False">
                <controls:ExpandableSection.SectionContent>
                    <VerticalStackLayout Spacing="8">
                        <editors:SliderEditor Label="Border Width"
                                              Value="{Binding BorderWidth}"
                                              Minimum="0"
                                              Maximum="10"
                                              Unit="px" />
                        <editors:SliderEditor Label="Border Radius"
                                              Value="{Binding BorderRadius}"
                                              Minimum="0"
                                              Maximum="35"
                                              Unit="px" />
                    </VerticalStackLayout>
                </controls:ExpandableSection.SectionContent>
            </controls:ExpandableSection>
            
            <controls:ExpandableSection Title="Shadow" Icon="💫" IsExpanded="False">
                <controls:ExpandableSection.SectionContent>
                    <VerticalStackLayout Spacing="8">
                        <editors:SliderEditor Label="Shadow Blur Radius"
                                              Value="{Binding ShadowBlurRadius}"
                                              Minimum="0"
                                              Maximum="20"
                                              Unit="px" />
                    </VerticalStackLayout>
                </controls:ExpandableSection.SectionContent>
            </controls:ExpandableSection>
            
            <!-- Examples Section -->
            <Label Text="Examples"
                   TextColor="#7C3AED"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,16,0,8" />
            
            <FlexLayout Wrap="Wrap" JustifyContent="SpaceEvenly" AlignItems="Center">
                <VerticalStackLayout Margin="8">
                    <aurora:CupertinoButton Text="Default"
                                            HeightRequest="40"
                                            WidthRequest="100" />
                    <Label Text="Default" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center" Margin="0,4,0,0" />
                </VerticalStackLayout>
                
                <VerticalStackLayout Margin="8">
                    <aurora:CupertinoButton Text="Custom"
                                            ButtonBackgroundColor="#22C55E"
                                            FontColor="White"
                                            BorderRadius="20"
                                            HeightRequest="40"
                                            WidthRequest="100" />
                    <Label Text="Green Pill" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center" Margin="0,4,0,0" />
                </VerticalStackLayout>
                
                <VerticalStackLayout Margin="8">
                    <aurora:CupertinoButton Text="Bordered"
                                            ButtonBackgroundColor="Transparent"
                                            FontColor="#7C3AED"
                                            BorderColor="#7C3AED"
                                            BorderWidth="2"
                                            BorderRadius="10"
                                            HeightRequest="40"
                                            WidthRequest="100" />
                    <Label Text="Outline" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center" Margin="0,4,0,0" />
                </VerticalStackLayout>
                
                <VerticalStackLayout Margin="8">
                    <aurora:CupertinoButton Text="Shadow"
                                            ButtonBackgroundColor="#EC4899"
                                            FontColor="White"
                                            ShadowBlurRadius="10"
                                            ShadowColor="#EC4899"
                                            HeightRequest="40"
                                            WidthRequest="100" />
                    <Label Text="Glow" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </FlexLayout>
            
            <!-- Bottom spacing -->
            <BoxView HeightRequest="40" Color="Transparent" />
            
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
